# Environment variables read by the local server (export them or prefix the command, e.g. `PORT=9000 npm run dev`).
# Copy to .env.local (git-ignored) if you like. Nothing here is a secret; real secrets live in AWS Secrets Manager (see docs/deployment.md).
PORT=8787
STORE=memory                       # memory | dynamo
DYNAMO_ENDPOINT=                   # e.g. http://localhost:8000 for DynamoDB Local
TABLE_NAME=Wellder-local
AUTH_MODE=dev                      # dev (local HMAC tokens) | cognito (API Gateway JWT authorizer)
DEV_JWT_SECRET=                    # optional; random per process when empty
PUSH_PROVIDER=log                  # log | apns | disabled
SMS_PROVIDER=disabled              # disabled | log | twilio   (twilio sends real, billable SMS)
VOICE_PROVIDER=disabled            # disabled | log | twilio   (twilio places real, billable calls)
SWEEP_INTERVAL_SECONDS=15
